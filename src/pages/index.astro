---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<Layout title="Most pod povrchem">
  {articles.length > 0 ? (
    <section class="tile-grid">
      {articles.map((article) => (
        <article class="tile">
          {article.data.image && (
            <a href={`/articles/${article.id.replace(/\.md$/, '')}`}>
              <img src={article.data.image} alt={article.data.title} />
            </a>
          )}
          <div class="tile-body">
            <div class="category">Nové</div>
            <div class="meta">{article.data.date.toLocaleDateString('cs-CZ')}</div>
            <h3>
              <a href={`/articles/${article.id.replace(/\.md$/, '')}`}>{article.data.title}</a>
            </h3>
            <p class="excerpt">{article.data.excerpt}</p>
          </div>
        </article>
      ))}
    </section>
  ) : (
    <p>Žádné články zatím nejsou.</p>
  )}
</Layout>