---
const { title = 'Most pod povrchem' } = Astro.props;
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
      :root {
        --bg: #0f0f0f;
        --header-bg: #1a1a1a;
        --text: #f5f5f5;
        --muted: #a1a1aa;
        --border: #2a2a2a;
        --accent: #f5c518;
        --card-bg: #161616;
      }
      * { box-sizing: border-box; }
      body {
        font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
        color: var(--text);
        background: var(--bg);
        margin: 0;
        line-height: 1.55;
      }
      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.25rem;
      }
      header {
        background: var(--header-bg);
        border-bottom: 1px solid var(--border);
        padding: 1rem 0 0.5rem;
      }
      .header-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.75rem;
      }
      .logo-wrap {
        text-align: center;
        flex: 1;
      }
      .logo {
        font-size: 2.25rem;
        font-weight: 800;
        text-decoration: none;
        color: #fff;
        letter-spacing: -0.03em;
        line-height: 1;
      }
      .logo span {
        color: var(--accent);
      }
      .header-actions {
        display: flex;
        gap: 0.5rem;
      }
      .btn {
        background: var(--accent);
        color: #111;
        font-weight: 700;
        border: none;
        padding: 0.5rem 1.1rem;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.9rem;
      }
      nav {
        display: flex;
        justify-content: center;
        gap: 1.75rem;
        padding: 0.6rem 0 0.8rem;
        border-top: 1px solid var(--border);
      }
      nav a {
        color: #e5e5e5;
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 500;
      }
      nav a:hover { color: var(--accent); }
      main { padding: 2rem 0 4rem; }
      footer {
        border-top: 1px solid var(--border);
        padding: 1.5rem 0;
        color: var(--muted);
        font-size: 0.85rem;
        text-align: center;
        background: #111;
      }
      /* Homepage layout */
      .home-grid {
        display: grid;
        grid-template-columns: 260px 1fr 260px;
        gap: 1.75rem;
        margin-bottom: 2.5rem;
      }
      .side-article img,
      .featured-main img,
      .card img {
        width: 100%;
        object-fit: cover;
        border-radius: 6px;
        display: block;
      }
      .side-article img {
        height: 140px;
        margin-bottom: 0.65rem;
      }
      .featured-main img {
        height: 280px;
        margin: 0.75rem 0 1rem;
      }
      .card img {
        height: 140px;
      }
      .category {
        color: var(--accent);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        margin-bottom: 0.3rem;
      }
      .meta {
        color: var(--muted);
        font-size: 0.78rem;
        margin-bottom: 0.45rem;
      }
      .side-article h3,
      .featured-main h2 {
        margin: 0 0 0.45rem;
        line-height: 1.22;
      }
      .side-article h3 {
        font-size: 1rem;
        font-weight: 700;
      }
      .featured-main h2 {
        font-size: 1.85rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin-bottom: 0.6rem;
      }
      .side-article h3 a,
      .featured-main h2 a,
      .card h3 a {
        color: inherit;
        text-decoration: none;
      }
      .side-article h3 a:hover,
      .featured-main h2 a:hover,
      .card h3 a:hover { text-decoration: underline; }
      .excerpt {
        color: #d4d4d8;
        font-size: 0.9rem;
        line-height: 1.45;
      }
      .more-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1.5rem;
      }
      .card {
        background: var(--card-bg);
        border-radius: 6px;
        overflow: hidden;
      }
      .card-body { padding: 0.75rem 0.9rem 1rem; }
      .card h3 {
        font-size: 1rem;
        font-weight: 700;
        margin: 0 0 0.35rem;
        line-height: 1.3;
      }
      .article-page {
        max-width: 760px;
        margin: 0 auto;
      }
      .article-page img {
        width: 100%;
        max-height: 420px;
        object-fit: cover;
        border-radius: 6px;
        margin-bottom: 1.25rem;
      }
      .article-page h1 {
        font-size: 2.3rem;
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: -0.025em;
        margin: 0 0 0.75rem;
      }
      .article-page :global(p) {
        font-size: 1.1rem;
        margin-bottom: 1.2rem;
        color: #e5e5e5;
      }
      @media (max-width: 980px) {
        .home-grid {
          grid-template-columns: 1fr;
        }
        .header-top { flex-direction: column; gap: 0.75rem; }
        .logo { font-size: 1.85rem; }
        nav { flex-wrap: wrap; gap: 1rem; }
        .featured-main h2 { font-size: 1.6rem; }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="container">
        <div class="header-top">
          <div style="width: 140px;"></div>
          <div class="logo-wrap">
            <a href="/" class="logo">Most pod <span>povrchem</span></a>
          </div>
          <div class="header-actions">
            <a href="#" class="btn">Join</a>
            <a href="#" class="btn">Login</a>
          </div>
        </div>
        <nav>
          <a href="/">Nové</a>
          <a href="#">Více</a>
          <a href="#">Hledat</a>
        </nav>
      </div>
    </header>
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
    <footer>
      <div class="container">
        <p>Most pod povrchem – satirický web.</p>
      </div>
    </footer>
  </body>
</html>